# YandexGPT API Configuration
# Получите API ключ в консоли Yandex Cloud: https://console.cloud.yandex.ru/
# Документация: https://cloud.yandex.ru/docs/foundation-models/quickstart/yandexgpt

# API ключ для доступа к YandexGPT
# Создайте API-ключ в разделе "Сервисные аккаунты" -> "API-ключи"
YANDEX_API_KEY=your_api_key_here

# ID каталога (folder) в Yandex Cloud
# Найдите в URL консоли или через команду: yc config list
YANDEX_FOLDER_ID=your_folder_id_here

# Модель YandexGPT (доступные: yandexgpt-lite, yandexgpt)
# yandexgpt-lite - быстрая и экономичная модель (рекомендуется)
# yandexgpt - более мощная модель
YANDEX_MODEL=yandexgpt-lite

# =============================================================================
# ИНСТРУКЦИЯ ПО НАСТРОЙКЕ:
# =============================================================================
#
# 1. Зарегистрируйтесь в Yandex Cloud: https://cloud.yandex.ru/
#
# 2. Создайте каталог (folder) или используйте существующий
#
# 3. Создайте сервисный аккаунт:
#    - Перейдите в раздел "Сервисные аккаунты"
#    - Нажмите "Создать сервисный аккаунт"
#    - Укажите имя (например, "forecast-api")
#    - Назначьте роль: ai.languageModels.user
#
# 4. Создайте API-ключ для сервисного аккаунта:
#    - Откройте сервисный аккаунт
#    - Перейдите в раздел "API-ключи"
#    - Нажмите "Создать API-ключ"
#    - Скопируйте ключ (он показывается только один раз!)
#
# 5. Скопируйте этот файл в config/.env и замените значения:
#    cp config/.env.example config/.env
#    nano config/.env
#
# 6. Перезапустите сервер:
#    cd backend && python main.py
#
# =============================================================================

# Настройки сервера
HOST=0.0.0.0
PORT=3000

# Настройки TimeLLM (опционально, для локальной LLM через GGUF)
# Оставьте пустым если не используете
TIMELLM_GGUF_PATH=
TIMELLM_N_CTX=2048
TIMELLM_N_THREADS=8
TIMELLM_N_GPU_LAYERS=0
TIMELLM_TEMPERATURE=0.3
